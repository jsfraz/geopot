# Copy this file to .env and replace every placeholder with a strong, unique
# value. Generate secrets for example with: openssl rand -base64 32
GIN_MODE=release
POSTGRES_USER=geopot
POSTGRES_PASSWORD=change-me
POSTGRES_SERVER=geopot-timescaledb
POSTGRES_PORT=5432
POSTGRES_DB=geopot
VALKEY_PASSWORD=change-me
VALKEY_SERVER=geopot-valkey
VALKEY_PORT=6379

# Comma separated browser origins allowed to access the API/WebSocket.
# Leave empty for same-origin only (recommended).
# ALLOWED_ORIGINS=https://geopot.example.com

# Comma separated reverse proxy addresses/CIDRs allowed to set
# X-Forwarded-For. Leave empty when the app is exposed directly.
# TRUSTED_PROXIES=172.16.0.0/12

# Optional hardening knobs
# API_RATE_LIMIT_PER_MINUTE=120
# WEBSOCKET_MAX_CLIENTS=1000
# SSH_MAX_CONNECTIONS=1024
# SSH_KEY_PATH=private_key.pem
